{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "description": "Hugo + xmin 静态博客，Pagefind 搜索 + Giscus 评论，部署到 Cloudflare Workers",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve --buildDrafts",
    "index": "pagefind --site public --glob \"**/*.html\" --force-language zh",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "wrangler": "^4.136.0"
  }
}
