// markdownlint-cli2 配置：只做 Markdown 排版检查，不写入项目依赖。
// 用法：npx --yes markdownlint-cli2@0.24.1
// 固定版本是为了 CI 与本机结果一致；规则按本仓库的中文长文调整，关闭项都写了原因。
{
  // 检查范围：已发布文章、草稿、仓库内的说明文档
  "globs": [
    "content/**/*.md",
    "docs/**/*.md",
    "*.md"
  ],
  // 构建产物与第三方目录不参与检查
  "ignores": [
    "public/**",
    "tmp/**",
    "_tmp/**",
    ".tools/**",
    "node_modules/**"
  ],
  "config": {
    "default": true,
    // 中文长文一句常超 100 字，不限制单行长度
    "MD013": false,
    // 文章以 YAML front matter 开头，不要求文件第一行就是标题
    "MD041": false,
    // 不同章节允许出现同名标题（如两处「参考」），只要求同一层级不重复
    "MD024": {
      "siblings_only": true
    },
    // 代码块统一用围栏式，不用缩进式
    "MD046": {
      "style": "fenced"
    },
    // 嵌套列表缩进用 2 个空格
    "MD007": {
      "indent": 2
    },
    // 不强制表格列宽对齐：中文全角字符宽度不稳定，对齐会引入噪音
    "MD060": false,
    // 代码段里保留「> 」「- 」这类带尾空格的写法，它们是引用与列表标记
    "MD038": false,
    // 正文里的 [提案 N1850]、[推断] 是证据标签，不是引用式链接
    "MD052": false
  }
}
